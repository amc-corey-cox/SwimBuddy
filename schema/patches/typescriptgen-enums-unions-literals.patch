+    def range_name(self, r: str) -> str:
+        sv = self.schemaview
+        if r in sv.all_enums():
+            return self.name(sv.get_enum(r))
+        if r in sv.all_classes():
+            return self.name(sv.get_class(r))
+        if r in sv.all_types():
+            t = sv.get_type(r)
+            if t.base and t.base in type_map:
+                return type_map[t.base]
+            if t.typeof and t.typeof in type_map:
+                return type_map[t.typeof]
+        return "string"
+
     def range(self, slot: SlotDefinition) -> str:
         sv = self.schemaview
